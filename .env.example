# HTTP/HTTPS server origin only. Request paths include /api separately.
# Restart the Vite dev server after changing this value.
# VITE_ variables are public in the browser. Never put secrets here.
VITE_API_BASE_URL=http://localhost:8080
# Evaluation UI wait (180 seconds), not an HTTP timeout. Expiry does not cancel the POST.
# Changing VITE_ variables requires a dev server restart or a new production build.
# Check proxy HTTP limits separately before production.
VITE_EVALUATION_TIMEOUT_MS=180000
